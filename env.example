# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua variabel MYSQL_* wajib diisi — aplikasi akan gagal saat start
# bila ada yang kosong.

MYSQL_HOST=localhost
MYSQL_USER=your_user
MYSQL_PASSWORD=your_password
MYSQL_DB=your_database
MYSQL_PORT=3306
MYSQL_CONNECT_TIMEOUT=10
# Jumlah koneksi di pool. Ini yang membatasi berapa banyak device bisa
# diproses bersamaan; naikkan bila unggahan mulai saling mengantre.
MYSQL_POOL_SIZE=10

# Umum
APP_NAME=ADMS
# DEBUG=true membuka /docs, /redoc, dan pesan error yang detail.
# DEBUG juga menentukan atribut `secure` cookie sesi admin: di produksi
# (DEBUG=false) cookie hanya dikirim lewat HTTPS, di pengembangan tidak —
# tanpa itu, login lewat http://localhost tampak berhasil tetapi cookie
# tidak terkirim sehingga seolah-olah tidak masuk.
DEBUG=false

# Level log aplikasi: DEBUG, INFO, WARNING, ERROR, atau CRITICAL.
# INFO untuk produksi; DEBUG bila sedang menelusuri device yang diam
# (mengaktifkan log per-request jalur ingest). Dipasang sekali saat start
# oleh app/logger.py.
LOG_LEVEL=INFO

# Zona waktu cadangan bila device belum punya `tz_name` (nama IANA).
DEFAULT_TZ_NAME=Asia/Jakarta
